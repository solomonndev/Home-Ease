# ============================================================
# SUPABASE DATABASE (PostgreSQL)
# ============================================================
# Get these from: Supabase Dashboard > Settings > Database > Connection string
# Use "Transaction" mode for DATABASE_URL (pooled)
# Use "Session" mode for DIRECT_URL (direct)

# Pooled connection (for app runtime — port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations — port 5432)
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ============================================================
# AUTH — Change this to a secure random string!
# ============================================================
JWT_SECRET=change-this-to-a-secure-random-string

# ============================================================
# PAYSTACK CONFIGURATION
# ============================================================
# Get from: https://dashboard.paystack.com > Settings > API Keys & Webhooks

PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ============================================================
# APP URL — Your Vercel deployment domain
# ============================================================
NEXT_PUBLIC_APP_URL=https://homeease.vercel.app
