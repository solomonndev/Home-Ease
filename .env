# ============================================================
# SUPABASE DATABASE (PostgreSQL)
# ============================================================
# Replace with your Supabase project connection strings
# Get these from: Supabase Dashboard > Settings > Database > Connection string

# Pooled connection (for app runtime - uses Supavisor port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations - uses port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ============================================================
# AUTH
# ============================================================
# Change this to a secure random string in production!
JWT_SECRET=domestic-services-secret-key-2024

# ============================================================
# PAYSTACK CONFIGURATION
# ============================================================
# Get these from your Paystack Dashboard at https://dashboard.paystack.com
# Go to Settings > API Keys & Webhooks

# Secret key (server-side only — used to initialize payments, create transfers, verify webhooks)
PAYSTACK_SECRET_KEY=sk_test_e0cba9dd24a0af08b574e90913ec72b0aa641d67

# Public key (exposed to client — used by Paystack inline popup)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_278b48522879f8a71f557fe4be25119023633b12

# Your production app URL (used for Paystack redirect callbacks)
# Replace with your actual Vercel domain, e.g. https://homeease.vercel.app
NEXT_PUBLIC_APP_URL=https://homeease.vercel.app
